# SafeDrive-AI Environment Variables Template
# Copy this file to .env and configure your optional settings.
# All SMS credentials are fully optional; the app defaults to MockSMSProvider.

# Optional: Twilio Configuration for Real SMS Alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_PHONE_NUMBER=

# Optional: WhatsApp Family Alert Configuration
# Set WHATSAPP_PROVIDER=mock for simulated zero-cost local testing (Default)
# Set WHATSAPP_PROVIDER=meta_cloud for official Meta WhatsApp Cloud API
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_LOCATION_UPDATE_INTERVAL=60
